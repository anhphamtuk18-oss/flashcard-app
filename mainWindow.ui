  <property name="styleSheet">
   <string notr="true">
* { font-family: &quot;Segoe UI&quot;; font-size: 10pt; color: #263247; }
QMainWindow, QWidget#centralWidget { background: #F5F7FB; }
QFrame#sidebarFrame { background: white; border-right: 1px solid #E8ECF3; }
QLabel#brandMark { background: #5B72E8; color: white; border-radius: 12px; font-size: 16pt; font-weight: 700; }
QLabel#brandName { font-size: 16pt; font-weight: 700; }
QLabel#sectionCaption { color: #93A0B5; font-size: 8pt; font-weight: 700; }
QPushButton { border: 1px solid #E1E6EF; border-radius: 9px; padding: 9px 14px; background: white; color: #43516A; }
QPushButton:hover { background: #F5F7FF; border-color: #AAB7F5; }
QPushButton:disabled { color: #A8B1C0; background: #F3F5F8; border-color: #E7EAF0; }
QPushButton#btnNewDeck, QPushButton#btnAddCard { background: #5B72E8; color: white; border: none; font-weight: 600; }
QPushButton#btnNewDeck:hover, QPushButton#btnAddCard:hover { background: #4B61D5; }
QLineEdit { background: white; border: 1px solid #E2E7F0; border-radius: 8px; padding: 9px 11px; }
QLineEdit:focus { border: 1px solid #8293F0; }
QListWidget { border: none; background: transparent; outline: none; }
QListWidget::item { padding: 12px; margin: 3px 0; border-radius: 9px; color: #66748B; }
QListWidget::item:selected { background: #EEF1FF; color: #4D63D6; font-weight: 600; }
QLabel#pageTitle { font-size: 21pt; font-weight: 700; }
QLabel#deckDescription, QLabel#mutedLabel { color: #8996AA; }
QFrame#metricCard, QFrame#metricCard2, QFrame#metricCard3 { background: white; border: 1px solid #E9EDF4; border-radius: 13px; }
QPushButton#navStudy, QPushButton#navManage, QPushButton#navQuiz { border: none; border-radius: 0; border-bottom: 2px solid transparent; background: transparent; color: #8793A7; padding: 11px 16px; font-weight: 600; }
QPushButton#navStudy:checked, QPushButton#navManage:checked, QPushButton#navQuiz:checked { color: #5269DD; border-bottom: 2px solid #5B72E8; }
QFrame#flashcardSurface, QFrame#quizCard { background: white; border: 1px solid #E8ECF3; border-radius: 20px; }
QLabel#cardEyebrow { color: #8290A7; font-size: 8pt; font-weight: 700; }
QLabel#cardTerm { font-size: 30pt; font-weight: 700; }
QLabel#cardTranslation { font-size: 24pt; font-weight: 700; }
QLabel#cardHint, QLabel#exampleText { color: #94A0B2; }
QPushButton#btnFlip { color: #5269DD; border-color: #DCE2FF; font-weight: 600; }
QPushButton#btnKnown { background: #22A579; color: white; border: none; font-weight: 600; }
QPushButton#btnRecordPronunciation { background: #22A579; color: white; border: none; font-weight: 600; }
QPushButton#btnSpeakTarget { color: #5269DD; border-color: #DCE2FF; font-weight: 600; }
QProgressBar#pronunciationScore { background: white; border: 1px solid #E1E6EF; border-radius: 7px; color: #5269DD; text-align: center; min-width: 92px; max-width: 112px; height: 18px; }
QProgressBar#pronunciationScore::chunk { background: #DCE3FF; border-radius: 6px; }
QTableWidget { background: white; border: 1px solid #E8ECF3; border-radius: 12px; gridline-color: #F0F2F6; selection-background-color: #EEF1FF; selection-color: #394EBC; }
QHeaderView::section { background: #F8F9FC; color: #8490A4; border: none; border-bottom: 1px solid #E8ECF3; padding: 11px; }
QLabel#quizPrompt { font-size: 20pt; font-weight: 700; }
QStatusBar { background: white; color: #8A96AA; border-top: 1px solid #E8ECF3; }
  </string>
